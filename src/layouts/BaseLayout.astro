---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { withBase } from "../lib/url";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  /** ISO timestamp; emitted as article:published_time for post pages. */
  publishedTime?: string;
}

const {
  title = "nonica | website",
  description = "nonicaのWebサイトです。",
  ogImage = "/og.png",
  ogType = "website",
  publishedTime,
} = Astro.props;

const base = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, base);
const ogImageUrl = new URL(withBase(ogImage), base);
const gaId = (import.meta.env.PUBLIC_GA_ID?.trim() || "G-F3YRJ3XXWK").trim();
---

<!doctype html>
<html lang="ja">
  <head>
    <script is:inline>
      // Applies the stored theme before first paint. Only an explicit choice is
      // written; without one the CSS `prefers-color-scheme` branch takes over.
      (() => {
        try {
          const savedTheme = localStorage.getItem("theme");
          if (savedTheme === "light" || savedTheme === "dark") {
            document.documentElement.dataset.theme = savedTheme;
          }
        } catch {
          // ignore storage errors
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="nonica" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400&family=Noto+Sans+JP:wght@400;500&family=Zen+Kaku+Gothic+New:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <ClientRouter />

    {
      gaId && (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
          ></script>
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
        </>
      )
    }
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <SiteHeader />
    <main id="main" class="container" tabindex="-1"><slot /></main>
    <SiteFooter />

    <script>
      // Module scripts run once for the lifetime of the ClientRouter session,
      // so the per-navigation work hangs off Astro's lifecycle events.
      const root = document.documentElement;
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      const storedTheme = () => {
        try {
          const theme = localStorage.getItem("theme");
          return theme === "light" || theme === "dark" ? theme : null;
        } catch {
          return null;
        }
      };

      const resolvedTheme = () =>
        storedTheme() ?? (prefersDark.matches ? "dark" : "light");

      // The icon itself is chosen by CSS off `data-theme` / the OS setting,
      // so only the accessible name needs to follow the state here.
      const syncButton = () => {
        const button = document.querySelector("[data-theme-toggle]");
        if (!button) return;

        const next = resolvedTheme() === "dark" ? "light" : "dark";
        const name = `Switch to ${next} mode`;
        button.setAttribute("aria-label", name);
        button.setAttribute("title", name);
      };

      // Absent an explicit choice we leave `data-theme` off entirely, which
      // hands control back to the `prefers-color-scheme` branch in global.css.
      const applyTheme = () => {
        const theme = storedTheme();
        if (theme) {
          root.dataset.theme = theme;
        } else {
          delete root.dataset.theme;
        }
        syncButton();
      };

      const bindToggle = () => {
        applyTheme();
        document
          .querySelector("[data-theme-toggle]")
          ?.addEventListener("click", () => {
            const nextTheme = resolvedTheme() === "dark" ? "light" : "dark";

            try {
              localStorage.setItem("theme", nextTheme);
            } catch {
              // ignore storage errors
            }

            if ("startViewTransition" in document && !reducedMotion.matches) {
              document.startViewTransition(applyTheme);
            } else {
              applyTheme();
            }
          });
      };

      // Fires on the initial load and after every client-side navigation. The
      // button element is replaced on swap, so its listener goes with it.
      document.addEventListener("astro:page-load", bindToggle);

      // A swap replaces the <html> attributes, taking `data-theme` with them.
      document.addEventListener("astro:after-swap", applyTheme);

      // With no stored choice the palette already follows the OS through CSS;
      // only the button's accessible name needs to catch up.
      prefersDark.addEventListener("change", () => {
        if (!storedTheme()) syncButton();
      });
    </script>
  </body>
</html>

<style>
  body {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    background: var(--bg);
    color: var(--fg);
    line-height: var(--lh-body);
    letter-spacing: 0.012em;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .container {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 1.75rem) var(--gutter) 0;
  }

  .container:focus {
    outline: none;
  }

  /* Sits off-screen until a keyboard user tabs onto it. */
  .skip-link {
    position: fixed;
    top: var(--sp-2);
    left: var(--sp-2);
    z-index: 20;
    padding: var(--sp-2) var(--sp-4);
    background: var(--bg);
    border: var(--rule);
    color: var(--fg);
    font-size: var(--fs-meta);
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 220ms;
    animation-timing-function: ease;
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0ms;
    }
  }
</style>
