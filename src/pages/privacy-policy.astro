---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Row from "../components/Row.astro";

const description =
  "当サイトのプライバシーポリシー。アクセス解析に Google Analytics を使用しています。";
---

<BaseLayout title="nonica | プライバシーポリシー" {description}>
  <PageHero title="プライバシーポリシー" size="small" />

  <Row label="Analytics" delay={70}>
    <p>
      当サイトでは、アクセス解析のためにGoogle Analyticsを使用しています。Google
      Analyticsはデータ収集のためにCookieを使用します。このデータは匿名で収集されており、個人を特定するものではありません。
    </p>
  </Row>

  <Row label="Opt out" delay={110}>
    <p>
      この機能はCookieを無効にすることで収集を拒否することができます。詳しくは
      <a
        class="text-link"
        href="https://policies.google.com/privacy?hl=ja"
        target="_blank"
        rel="noreferrer"
      >
        Googleのプライバシーポリシー<span aria-hidden="true"> ↗</span>
      </a>
      をご確認ください。
    </p>
  </Row>
</BaseLayout>

<style>
  p {
    max-width: 60ch;
  }
</style>
