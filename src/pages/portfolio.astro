---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Row from "../components/Row.astro";
import Keywords from "../components/Keywords.astro";

const profile = {
  name: "nonica",
  handle: "no2ca",
  role: "Systems & Low-level Software",
  location: "Yokohama, Japan",
  date: "2026-09-08",
};

// One line under the name so the page can be understood without scrolling.
const summary =
  "OS・コンパイラ・ベアメタル実装を中心としたシステムソフトウェア開発の経歴と成果物。";

const skillGroups = [
  { title: "Languages", items: ["Rust", "C", "C++"] },
  {
    title: "Systems",
    items: ["Operating Systems", "RV64", "x86-64", "AArch64", "Hypervisor"],
  },
  { title: "Tools", items: ["Git", "Linux", "QEMU", "Docker"] },
];

const projects = [
  {
    name: "RV64 Operating System",
    what: "RV64 上で動作する最小カーネルを実装。仮想メモリ、ページング、トラップ処理、ELF ローダ、システムコール（create/yield/exit）を構築。",
    tech: ["Rust", "RV64", "QEMU", "Kernel Development"],
    github: "https://github.com/no2ca/nex_os",
    demo: "",
  },
  {
    name: "C Subset Compiler",
    what: "x86-64 Linux（SysV ABI, ELF）向け C サブセットコンパイラを実装。lexer / parser / AST / IR / 線形スキャンレジスタ割当 / Intel 構文コード生成まで対応。",
    tech: ["Rust", "x86-64", "Linux", "Compiler"],
    github: "https://github.com/no2ca/nonicc",
    demo: "",
  },
  {
    name: "x86 Bootloader & Game of Life Runtime",
    what: "独自 x86 ブートローダを開発し、OS 非依存で Rust 製ライフゲームをロード・実行。メモリレイアウトとバイナリローディングを自前で構成。",
    tech: ["Rust", "x86 Assembly", "Bare Metal"],
    github: "https://github.com/no2ca/lifegame",
    demo: "",
  },
];

const experiences = [
  {
    period: "2026年3月",
    title: "セキュリティキャンプ2026 コネクト（OSクラス）",
    detail:
      "「エンジニアでない方々にOSのセキュリティ知識を楽しく身に着けてもらうには」をテーマに、4日間でボードゲーム形式の教材を制作・発表。",
  },
  {
    period: "2025 - Present",
    title: "個人開発（システムソフトウェア）",
    detail:
      "OS・コンパイラ・ベアメタル実装を継続。GitHub で開発履歴と成果物を公開。",
  },
  {
    period: "2025年5月 - 2025年12月",
    title: "株式会社G-VIS（インターン）",
    detail: "AIエージェントを活用したWebアプリケーションのPoC開発。",
  },
];

const education = {
  school: "慶應義塾大学",
  faculty: "環境情報学部 学士課程",
  expected: "2028年3月卒業予定",
  courses: [
    "Computer Architecture",
    "Operating Systems",
    "Software Architecture",
  ],
};

const contacts = [
  {
    label: "GitHub",
    text: "github.com/no2ca",
    url: "https://github.com/no2ca",
  },
  {
    label: "Bluesky",
    text: "@nonica",
    url: "https://bsky.app/profile/did:plc:wvwzypmkkewmn3yaedrpzncd",
  },
  { label: "X", text: "@no2cax", url: "https://x.com/no2cax" },
];

const description = `${profile.name}（${profile.handle}）のポートフォリオ。${summary}`;
---

<BaseLayout title="nonica | Portfolio" {description}>
  <PageHero label="Portfolio" title={profile.name}>
    <ul class="meta keywords">
      <li>{profile.handle}</li>
      <li>{profile.role}</li>
      <li>{profile.location}</li>
    </ul>
    <p class="summary">{summary}</p>
    <p class="label hero-date">Updated {profile.date}</p>
  </PageHero>

  <Row id="skills" label="Skills" delay={70}>
    <dl class="spec">
      {
        skillGroups.map((group) => (
          <div class="spec-row">
            <dt class="label">{group.title}</dt>
            <dd>
              <Keywords items={group.items} />
            </dd>
          </div>
        ))
      }
    </dl>
  </Row>

  <Row id="projects" label="Projects" delay={110}>
    <ul class="projects">
      {
        projects.map((project) => (
          <li class="project">
            <h3>
              {project.github ? (
                <a href={project.github} target="_blank" rel="noreferrer">
                  {project.name}
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              ) : (
                project.name
              )}
            </h3>
            <p class="project-what">{project.what}</p>
            <div class="project-foot">
              <Keywords items={project.tech} />
              {project.demo && (
                <a
                  class="text-link demo"
                  href={project.demo}
                  target="_blank"
                  rel="noreferrer"
                >
                  Demo<span aria-hidden="true"> ↗</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </Row>

  <Row id="experience" label="Experience" delay={150}>
    <ol class="history">
      {
        experiences.map((item) => (
          <li class="entry">
            <p class="label period">{item.period}</p>
            <div class="entry-body">
              <h3 class="entry-title">{item.title}</h3>
              <p class="entry-detail">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Row>

  <Row id="education" label="Education" delay={190}>
    <div class="entry">
      <p class="label period">{education.expected}</p>
      <div class="entry-body">
        <h3 class="entry-title">{education.school}</h3>
        <p class="entry-detail">{education.faculty}</p>
        <div class="coursework">
          <p class="label">Coursework</p>
          <Keywords items={education.courses} />
        </div>
      </div>
    </div>
  </Row>

  <Row id="contact" label="Contact" delay={230}>
    <dl class="spec">
      {
        contacts.map((contact) => (
          <div class="spec-row">
            <dt class="label">{contact.label}</dt>
            <dd>
              <a
                class="contact-link"
                href={contact.url}
                target="_blank"
                rel="noreferrer"
              >
                {contact.text}
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </Row>
</BaseLayout>

<style>
  /* --- hero --- */

  .meta {
    margin-top: var(--sp-3);
    font-size: var(--fs-meta);
  }

  .summary {
    margin-top: var(--sp-4);
    max-width: 60ch;
  }

  .hero-date {
    margin-top: var(--sp-4);
  }

  /* --- label | value rows (Skills, Coursework, Contact) --- */

  .spec {
    margin: 0;
    display: grid;
    gap: var(--sp-3);
  }

  .spec-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--sp-1) var(--sp-4);
    align-items: baseline;
  }

  .spec dt {
    /* Sits on the value's first line. */
    line-height: 1.7;
  }

  .spec dd {
    margin: 0;
    min-width: 0;
  }

  /* --- projects --- */

  .projects {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-6);
  }

  .project h3 {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .project h3 a,
  .contact-link {
    color: var(--fg);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .arrow {
    color: var(--muted);
    font-weight: 400;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .project h3 a:hover,
  .contact-link:hover,
  .project h3 a:hover .arrow,
  .contact-link:hover .arrow {
    color: var(--accent);
  }

  .project h3 a:hover .arrow,
  .contact-link:hover .arrow {
    transform: translate(1px, -1px);
  }

  .project-what {
    margin-top: var(--sp-1);
    color: var(--muted);
    font-size: var(--fs-lead);
  }

  .project-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-4);
    margin-top: var(--sp-2);
  }

  .demo {
    font-size: var(--fs-meta);
  }

  /* --- experience / education --- */

  .history {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-5);
  }

  /* Period in a narrow column, the entry beside it, so the dates read as a
     timeline down the left and the titles line up. */
  .entry {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--sp-1) var(--sp-4);
    align-items: baseline;
  }

  /* Tracked a little tighter than other labels so the longest period,
     "2025年5月 - 2025年12月", stays on one line in its column. */
  .period {
    letter-spacing: 0.04em;
    line-height: 1.7;
  }

  .entry-body {
    min-width: 0;
  }

  .entry-title {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .entry-detail {
    margin-top: var(--sp-1);
    color: var(--muted);
    font-size: var(--fs-lead);
  }

  .coursework {
    display: grid;
    gap: var(--sp-1);
    margin-top: var(--sp-3);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    padding-block: var(--sp-1);
  }

  @media screen and (max-width: 680px) {
    .spec-row,
    .entry {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .period {
      margin-bottom: 0.1rem;
    }
  }
</style>
