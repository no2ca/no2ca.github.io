---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Row from "../components/Row.astro";
import TagList from "../components/TagList.astro";

const profile = {
  name: "nonica",
  handle: "no2ca",
  role: "Systems & Low-level Software",
  location: "Yokohama, Japan",
  date: "2026-09-08",
};

const skillGroups = [
  { title: "Languages", items: ["Rust", "C", "C++"] },
  {
    title: "Systems",
    items: ["Operating Systems", "RV64", "x86-64", "AArch64", "Hypervisor"],
  },
  { title: "Tools", items: ["Git", "Linux", "QEMU", "Docker"] },
];

const projects = [
  {
    name: "RV64 Operating System",
    what: "RV64 上で動作する最小カーネルを実装。仮想メモリ、ページング、トラップ処理、ELF ローダ、システムコール（create/yield/exit）を構築。",
    tech: ["Rust", "RV64", "QEMU", "Kernel Development"],
    github: "https://github.com/no2ca/nex_os",
    demo: "",
  },
  {
    name: "C Subset Compiler",
    what: "x86-64 Linux（SysV ABI, ELF）向け C サブセットコンパイラを実装。lexer / parser / AST / IR / 線形スキャンレジスタ割当 / Intel 構文コード生成まで対応。",
    tech: ["Rust", "x86-64", "Linux", "Compiler"],
    github: "https://github.com/no2ca/nonicc",
    demo: "",
  },
  {
    name: "x86 Bootloader & Game of Life Runtime",
    what: "独自 x86 ブートローダを開発し、OS 非依存で Rust 製ライフゲームをロード・実行。メモリレイアウトとバイナリローディングを自前で構成。",
    tech: ["Rust", "x86 Assembly", "Bare Metal"],
    github: "https://github.com/no2ca/lifegame",
    demo: "",
  },
];

const experiences = [
  {
    period: "2026年3月",
    title: "セキュリティキャンプ2026 コネクト（OSクラス）",
    detail:
      "「エンジニアでない方々にOSのセキュリティ知識を楽しく身に着けてもらうには」をテーマに、4日間でボードゲーム形式の教材を制作・発表。",
  },
  {
    period: "2025 - Present",
    title: "個人開発（システムソフトウェア）",
    detail:
      "OS・コンパイラ・ベアメタル実装を継続。GitHub で開発履歴と成果物を公開。",
  },
  {
    period: "2025年5月 - 2025年12月",
    title: "株式会社G-VIS（インターン）",
    detail: "AIエージェントを活用したWebアプリケーションのPoC開発。",
  },
];

const education = {
  school: "慶應義塾大学",
  faculty: "環境情報学部 学士課程",
  expected: "2028年3月卒業予定",
  courses: [
    "Computer Architecture",
    "Operating Systems",
    "Software Architecture",
  ],
};

const description = `${profile.name}（${profile.handle}）のポートフォリオ。OS・コンパイラ・ベアメタル実装を中心としたシステムソフトウェア開発の経歴と成果物。`;
---

<BaseLayout title="nonica | Portfolio" {description}>
  <PageHero label="Portfolio" title={profile.name}>
    <div class="meta">
      <span>{profile.handle}</span>
      <span>{profile.role}</span>
      <span>{profile.location}</span>
    </div>
    <p class="label hero-date">Last updated {profile.date}</p>
  </PageHero>

  <Row label="Skills" delay={70}>
    <div class="skill-groups">
      {
        skillGroups.map((group) => (
          <div class="skill-group">
            <p class="label group-title">{group.title}</p>
            <TagList items={group.items} />
          </div>
        ))
      }
    </div>
  </Row>

  <Row label="Projects" delay={110}>
    <ul class="projects">
      {
        projects.map((project) => (
          <li class="project">
            <h2>{project.name}</h2>
            <p class="project-what">{project.what}</p>
            <TagList items={project.tech} />
            <div class="project-links">
              <a href={project.github} target="_blank" rel="noreferrer">
                GitHub<span aria-hidden="true"> ↗</span>
              </a>
              {project.demo && (
                <a href={project.demo} target="_blank" rel="noreferrer">
                  Demo<span aria-hidden="true"> ↗</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </Row>

  <Row label="Experience" delay={150}>
    <ul class="history">
      {
        experiences.map((item) => (
          <li>
            <p class="label period">{item.period}</p>
            <p class="history-title">{item.title}</p>
            <p class="history-detail">{item.detail}</p>
          </li>
        ))
      }
    </ul>
  </Row>

  <Row label="Education" delay={190}>
    <p>{education.school}</p>
    <p>{education.faculty}</p>
    <p class="muted">{education.expected}</p>
    <p class="label group-title coursework">Relevant Coursework</p>
    <TagList items={education.courses} />
  </Row>

  <Row label="Contact" delay={230}>
    <ul class="contact">
      <li>
        <p class="label">GitHub</p>
        <p>
          <a href="https://github.com/no2ca" target="_blank" rel="noreferrer">
            github.com/no2ca<span aria-hidden="true"> ↗</span>
          </a>
        </p>
      </li>
      <li>
        <p class="label">Bluesky</p>
        <p>
          <a
            href="https://bsky.app/profile/did:plc:wvwzypmkkewmn3yaedrpzncd"
            target="_blank"
            rel="noreferrer"
          >
            @nonica<span aria-hidden="true"> ↗</span>
          </a>
        </p>
      </li>
      <li>
        <p class="label">X</p>
        <p>
          <a href="https://x.com/no2cax" target="_blank" rel="noreferrer">
            @no2cax<span aria-hidden="true"> ↗</span>
          </a>
        </p>
      </li>
    </ul>
  </Row>
</BaseLayout>

<style>
  .meta {
    margin-top: var(--sp-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: 1.6;
  }

  .hero-date {
    margin-top: var(--sp-2);
  }

  .skill-groups {
    display: grid;
    gap: var(--sp-4);
  }

  .group-title {
    margin-bottom: var(--sp-2);
  }

  .projects,
  .history,
  .contact {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }

  .projects {
    gap: var(--sp-4);
  }

  .project + .project {
    padding-top: var(--sp-4);
    border-top: var(--rule);
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .project-what {
    margin: 0.3rem 0 var(--sp-3);
    color: var(--muted);
    font-size: var(--fs-lead);
  }

  .project-links {
    margin-top: var(--sp-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
    font-size: var(--fs-meta);
  }

  a {
    color: var(--fg);
    text-decoration: none;
    border-bottom: var(--rule);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .muted {
    color: var(--muted);
    font-size: var(--fs-meta);
  }

  .history {
    gap: var(--sp-4);
  }

  .history-title {
    font-weight: 400;
  }

  .history-detail {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: var(--fs-lead);
  }

  .coursework {
    margin-top: var(--sp-3);
  }

  .contact {
    gap: var(--sp-3);
  }
</style>
