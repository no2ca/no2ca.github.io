---
import BaseLayout from "../layouts/BaseLayout.astro";
import Row from "../components/Row.astro";
import TagList from "../components/TagList.astro";

const profile = {
  name: "Taisei Ono",
  handle: "nonica / no2ca",
  role: "Systems & Low-level Software",
  location: "Yokohama, Japan",
  date: "2026-03-31",
};

const about = [
  "慶應義塾大学 環境情報学部に在籍し、低レイヤソフトウェア開発を中心に学んでいます。",
  "主な関心領域は OS、コンパイラ、コンピュータアーキテクチャです。",
  "Rust と C を使って、実装しながら内部構造を理解するスタイルで開発しています。",
  "現在はAArch64向けハイパーバイザを継続開発中です。",
];

const skillGroups = [
  { title: "Languages", items: ["Rust", "C", "C++"] },
  {
    title: "Systems",
    items: ["Operating Systems", "RV64", "x86-64", "AArch64", "Hypervisor"],
  },
  { title: "Tools", items: ["Git", "Linux", "QEMU", "Docker"] },
];

const projects = [
  {
    name: "RV64 Operating System",
    what: "RV64 上で動作する最小カーネルを実装。仮想メモリ、ページング、トラップ処理、ELF ローダ、システムコール（create/yield/exit）を構築。",
    tech: ["Rust", "RV64", "QEMU", "Kernel Development"],
    github: "https://github.com/no2ca/nex_os",
    demo: "",
  },
  {
    name: "C Subset Compiler",
    what: "x86-64 Linux（SysV ABI, ELF）向け C サブセットコンパイラを実装。lexer / parser / AST / IR / 線形スキャンレジスタ割当 / Intel 構文コード生成まで対応。",
    tech: ["Rust", "x86-64", "Linux", "Compiler"],
    github: "https://github.com/no2ca/nonicc",
    demo: "",
  },
  {
    name: "x86 Bootloader & Game of Life Runtime",
    what: "独自 x86 ブートローダを開発し、OS 非依存で Rust 製ライフゲームをロード・実行。メモリレイアウトとバイナリローディングを自前で構成。",
    tech: ["Rust", "x86 Assembly", "Bare Metal"],
    github: "https://github.com/no2ca/lifegame",
    demo: "",
  },
];

const experiences = [
  {
    period: "2026年3月",
    title: "セキュリティキャンプ2026 コネクト（OSクラス）",
    detail:
      "「エンジニアでない方々にOSのセキュリティ知識を楽しく身に着けてもらうには」をテーマに、4日間でボードゲーム形式の教材を制作・発表。",
  },
  {
    period: "2025 - Present",
    title: "個人開発（システムソフトウェア）",
    detail:
      "OS・コンパイラ・ベアメタル実装を継続。GitHub で開発履歴と成果物を公開。",
  },
  {
    period: "2025年5月 - 2025年12月",
    title: "株式会社G-VIS",
    detail: "AIエージェントを活用したWebアプリケーションのPoC開発。",
  },
];

const education = {
  school: "慶應義塾大学",
  faculty: "環境情報学部 学士課程",
  expected: "2028年3月卒業予定",
  courses: [
    "Computer Architecture",
    "Operating Systems",
    "Software Architecture",
  ],
};

const description = `${profile.name}（${profile.handle}）のポートフォリオ。OS・コンパイラ・ベアメタル実装を中心としたシステムソフトウェア開発の経歴と成果物。`;
---

<BaseLayout title="nonica | Portfolio" {description}>
  <header class="hero">
    <p class="label hero-label">Portfolio</p>
    <div class="hero-body">
      <h1>{profile.name}</h1>
      <div class="meta">
        <span>{profile.handle}</span>
        <span>{profile.role}</span>
        <span>{profile.location}</span>
      </div>
      <p class="label hero-date">Last updated {profile.date}</p>
    </div>
  </header>

  <Row label="About" delay={70}>
    {about.map((line) => <p class="about-line">{line}</p>)}
  </Row>

  <Row label="Skills" delay={110}>
    <div class="skill-groups">
      {
        skillGroups.map((group) => (
          <div class="skill-group">
            <p class="label group-title">{group.title}</p>
            <TagList items={group.items} />
          </div>
        ))
      }
    </div>
  </Row>

  <Row label="Projects" delay={150}>
    <ul class="projects">
      {
        projects.map((project) => (
          <li class="project">
            <h2>{project.name}</h2>
            <p class="project-what">{project.what}</p>
            <TagList items={project.tech} />
            <div class="project-links">
              <a href={project.github} target="_blank" rel="noreferrer">
                GitHub<span aria-hidden="true"> ↗</span>
              </a>
              {project.demo && (
                <a href={project.demo} target="_blank" rel="noreferrer">
                  Demo<span aria-hidden="true"> ↗</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </Row>

  <Row label="Experience" delay={190}>
    <ul class="history">
      {
        experiences.map((item) => (
          <li>
            <p class="label period">{item.period}</p>
            <p class="history-title">{item.title}</p>
            <p class="history-detail">{item.detail}</p>
          </li>
        ))
      }
    </ul>
  </Row>

  <Row label="Education" delay={230}>
    <p>{education.school}</p>
    <p>{education.faculty}</p>
    <p class="muted">{education.expected}</p>
    <p class="label group-title coursework">Relevant Coursework</p>
    <TagList items={education.courses} />
  </Row>

  <Row label="Contact" delay={270}>
    <ul class="contact">
      <li>
        <p class="label">Email</p>
        <p>taiseiono6[@]gmail.com</p>
      </li>
      <li>
        <p class="label">GitHub</p>
        <p>
          <a href="https://github.com/no2ca" target="_blank" rel="noreferrer">
            github.com/no2ca<span aria-hidden="true"> ↗</span>
          </a>
        </p>
      </li>
    </ul>
  </Row>
</BaseLayout>

<style>
  /* Mirrors the Row grid so the eyebrow lines up with the labels below. */
  .hero {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    gap: 0 var(--sp-6);
    align-items: start;
    padding-block: var(--sp-8);
    animation: rise 420ms ease both;
  }

  .hero-label {
    line-height: var(--lh-body);
  }

  h1 {
    font-size: clamp(1.9rem, 5.5vw, 2.7rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .meta {
    margin-top: var(--sp-3);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    color: var(--muted);
    font-size: var(--fs-meta);
    line-height: 1.6;
  }

  .hero-date {
    margin-top: var(--sp-2);
  }

  .about-line + .about-line {
    margin-top: var(--sp-2);
  }

  .skill-groups {
    display: grid;
    gap: var(--sp-4);
  }

  .group-title {
    margin-bottom: var(--sp-2);
  }

  .projects,
  .history,
  .contact {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
  }

  .projects {
    gap: var(--sp-4);
  }

  .project + .project {
    padding-top: var(--sp-4);
    border-top: var(--rule);
  }

  h2 {
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.4;
  }

  .project-what {
    margin: 0.3rem 0 var(--sp-3);
    color: var(--muted);
    font-size: var(--fs-lead);
  }

  .project-links {
    margin-top: var(--sp-3);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2) var(--sp-4);
    font-size: var(--fs-meta);
  }

  a {
    color: var(--fg);
    text-decoration: none;
    border-bottom: var(--rule);
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .muted {
    color: var(--muted);
    font-size: var(--fs-meta);
  }

  .history {
    gap: var(--sp-4);
  }

  .history-title {
    font-weight: 400;
  }

  .history-detail {
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: var(--fs-lead);
  }

  .coursework {
    margin-top: var(--sp-3);
  }

  .contact {
    gap: var(--sp-3);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 680px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
      padding-block: var(--sp-6);
    }

    .hero-label {
      line-height: 1.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      animation: none;
    }
  }
</style>
