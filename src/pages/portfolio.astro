---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Row from "../components/Row.astro";
import Keywords from "../components/Keywords.astro";

const profile = {
  name: "nonica",
  handle: "no2ca",
  role: "Infrastructure & Systems Software",
  location: "Yokohama, Japan",
  date: "2026-09-23",
};

// One line under the name so the page can be understood without scrolling.
const summary =
  "Kubernetes ネットワークを中心としたインフラと、OS・ハイパーバイザなど低レイヤの開発の経歴と成果物です。";

const skillGroups = [
  { title: "Languages", items: ["Go", "Rust", "C", "C++", "Haskell"] },
  {
    title: "Infrastructure",
    items: ["Kubernetes", "Cilium", "CNI", "AWS", "Terraform"],
  },
  {
    title: "Systems",
    items: [
      "Hypervisor",
      "Bare Metal",
      "eBPF",
      "Intel TDX / TEE",
      "Linux Kernel Modules",
      "AArch64",
      "RV64",
      "x86-64",
    ],
  },
  { title: "Tools", items: ["Git", "Linux", "QEMU", "Docker"] },
];

// Current work leads; the earlier low-level projects follow as the
// groundwork it builds on. Leave `github` empty for a private repository.
const projectSections = [
  {
    id: "projects",
    label: "Projects",
    projects: [
      {
        name: "User-space TCP/IP Stack",
        what: "Go によるユーザ空間 TCP/IP スタック。TUN の読み書き、IPv4 のパースと組み立て（チェックサム含む）、TCP ヘッダのパースとシリアライズを実装し、TCP 状態機械は CLOSED / LISTEN / SYN-RECEIVED / ESTABLISHED まで動作します。",
        tech: ["Go", "TCP/IP", "TUN", "Linux"],
        github: "https://github.com/no2ca/go-tuntcp",
        demo: "",
      },
      {
        name: "Typed Lambda Calculus in Haskell",
        what: "TAPL を読みながら章ごとに処理系を Haskell で実装。算術式から着手し、単純型付きラムダ計算とその拡張までを今学期の目標としています。",
        tech: ["Haskell", "Type Systems"],
        github: "https://github.com/no2ca/tapl-hs",
        demo: "",
      },
    ],
  },
  {
    id: "earlier-work",
    label: "Earlier Work",
    projects: [
      {
        name: "AArch64 Hypervisor",
        what: "書籍を参考に Rust で AArch64 向け Type-1 ハイパーバイザを実装し、Raspberry Pi 4 へ移植。",
        tech: ["Rust", "AArch64", "Raspberry Pi 4", "Hypervisor"],
        github: "https://github.com/no2ca/min1visor",
        demo: "",
      },
      {
        name: "RV64 Operating System",
        what: "RV64 上で動作する最小カーネルを実装。仮想メモリ、ページング、トラップ処理、ELF ローダ、システムコール（create/yield/exit）を構築。",
        tech: ["Rust", "RV64", "QEMU", "Kernel Development"],
        github: "https://github.com/no2ca/nex_os",
        demo: "",
      },
      {
        name: "C Subset Compiler",
        what: "x86-64 Linux（SysV ABI, ELF）向け C サブセットコンパイラを実装。lexer / parser / AST / IR / 線形スキャンレジスタ割当 / Intel 構文コード生成まで対応。",
        tech: ["Rust", "x86-64", "Linux", "Compiler"],
        github: "https://github.com/no2ca/nonicc",
        demo: "",
      },
      {
        name: "x86 Bootloader & Game of Life Runtime",
        what: "独自 x86 ブートローダを開発し、OS 非依存で Rust 製ライフゲームをロード・実行。メモリレイアウトとバイナリローディングを自前で構成。",
        tech: ["Rust", "x86 Assembly", "Bare Metal"],
        github: "https://github.com/no2ca/lifegame",
        demo: "",
      },
    ],
  },
];

const experiences = [
  {
    period: "2026年8月",
    title: "サイボウズ株式会社（インターン）",
    detail:
      "Kubernetes のネットワーク領域で、CNI チェイニングの一本化、Cilium の BGP 広告機能の導入、独自 CNI の一部機能の再統合、ルーティングテーブルに出力するカスタムコントローラーの組み込みに取り組んだ。",
  },
  {
    period: "2026年8月",
    title: "セキュリティキャンプ全国大会2026 TEEゼミ「CVM ビルド&スクラップ」",
    detail:
      "応募課題で Intel TDX をはじめとする TEE を調査。実習では Confidential VM を対象に、ディスクロールバック攻撃や構造体パディング領域からの情報流出を検証し、eBPF とカーネルモジュールで TDX 特有のイベントをフックする実装に取り組んだ。",
  },
  {
    period: "2026年3月",
    title: "セキュリティキャンプ2026 コネクト（OSクラス）",
    detail:
      "「エンジニアでない方々にOSのセキュリティ知識を楽しく身に着けてもらうには」をテーマに、4日間でボードゲーム形式の教材を制作・発表。",
  },
  {
    period: "2025 - Present",
    title: "個人開発（システムソフトウェア・インフラ）",
    detail:
      "OS・コンパイラ・ハイパーバイザなどの低レイヤから、Go によるネットワーク・インフラへと対象を広げて継続。GitHub で開発履歴と成果物を公開。",
  },
  {
    period: "2025年5月 - 2025年12月",
    title: "株式会社G-VIS（インターン）",
    detail: "AIエージェントを活用したWebアプリケーションのPoC開発。",
  },
];

const education = {
  school: "慶應義塾大学",
  faculty: "環境情報学部 学士課程",
  expected: "2028年3月卒業予定",
  courses: [
    "Computer Architecture",
    "Operating Systems",
    "Software Architecture",
  ],
};

const contacts = [
  {
    label: "GitHub",
    text: "github.com/no2ca",
    url: "https://github.com/no2ca",
  },
  {
    label: "Bluesky",
    text: "@nonica",
    url: "https://bsky.app/profile/did:plc:wvwzypmkkewmn3yaedrpzncd",
  },
  { label: "X", text: "@no2cax", url: "https://x.com/no2cax" },
];

const description = `${profile.name}（${profile.handle}）のポートフォリオ。${summary}`;
---

<BaseLayout title="nonica | Portfolio" {description}>
  <PageHero label="Portfolio" title={profile.name}>
    <ul class="meta keywords">
      <li>{profile.handle}</li>
      <li>{profile.role}</li>
      <li>{profile.location}</li>
    </ul>
    <p class="summary">{summary}</p>
    <p class="label hero-date">Updated {profile.date}</p>
  </PageHero>

  <Row id="skills" label="Skills" delay={70}>
    <dl class="spec">
      {
        skillGroups.map((group) => (
          <div class="spec-row">
            <dt class="label">{group.title}</dt>
            <dd>
              <Keywords items={group.items} />
            </dd>
          </div>
        ))
      }
    </dl>
  </Row>

  {
    projectSections.map((section, i) => (
      <Row id={section.id} label={section.label} delay={110 + i * 40}>
        <ul class="projects">
          {section.projects.map((project) => (
            <li class="project">
              <h3>
                {project.github ? (
                  <a href={project.github} target="_blank" rel="noreferrer">
                    {project.name}
                    <span class="arrow" aria-hidden="true">
                      ↗
                    </span>
                  </a>
                ) : (
                  project.name
                )}
              </h3>
              <p class="project-what">{project.what}</p>
              <div class="project-foot">
                <Keywords items={project.tech} />
                {project.demo && (
                  <a
                    class="text-link demo"
                    href={project.demo}
                    target="_blank"
                    rel="noreferrer"
                  >
                    Demo<span aria-hidden="true"> ↗</span>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </Row>
    ))
  }

  <Row id="experience" label="Experience" delay={190}>
    <ol class="history">
      {
        experiences.map((item) => (
          <li class="entry">
            <p class="label period">{item.period}</p>
            <div class="entry-body">
              <h3 class="entry-title">{item.title}</h3>
              <p class="entry-detail">{item.detail}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Row>

  <Row id="education" label="Education" delay={230}>
    <div class="entry">
      <p class="label period">{education.expected}</p>
      <div class="entry-body">
        <h3 class="entry-title">{education.school}</h3>
        <p class="entry-detail">{education.faculty}</p>
        <div class="coursework">
          <p class="label">Coursework</p>
          <Keywords items={education.courses} />
        </div>
      </div>
    </div>
  </Row>

  <Row id="contact" label="Contact" delay={270}>
    <dl class="spec">
      {
        contacts.map((contact) => (
          <div class="spec-row">
            <dt class="label">{contact.label}</dt>
            <dd>
              <a
                class="contact-link"
                href={contact.url}
                target="_blank"
                rel="noreferrer"
              >
                {contact.text}
                <span class="arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            </dd>
          </div>
        ))
      }
    </dl>
  </Row>
</BaseLayout>

<style>
  /* --- hero --- */

  .meta {
    margin-top: var(--sp-3);
    font-size: var(--fs-meta);
  }

  .summary {
    margin-top: var(--sp-4);
    max-width: 60ch;
  }

  .hero-date {
    margin-top: var(--sp-4);
  }

  /* --- label | value rows (Skills, Coursework, Contact) --- */

  .spec {
    margin: 0;
    display: grid;
    gap: var(--sp-3);
  }

  .spec-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--sp-1) var(--sp-4);
    align-items: baseline;
  }

  .spec dt {
    /* Sits on the value's first line. */
    line-height: 1.7;
  }

  .spec dd {
    margin: 0;
    min-width: 0;
  }

  /* --- projects --- */

  .projects {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-6);
  }

  .project h3 {
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .project h3 a,
  .contact-link {
    color: var(--fg);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .arrow {
    color: var(--muted);
    font-weight: 400;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .project h3 a:hover,
  .contact-link:hover,
  .project h3 a:hover .arrow,
  .contact-link:hover .arrow {
    color: var(--accent);
  }

  .project h3 a:hover .arrow,
  .contact-link:hover .arrow {
    transform: translate(1px, -1px);
  }

  .project-what {
    margin-top: var(--sp-1);
    color: var(--muted);
    font-size: var(--fs-lead);
  }

  .project-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-4);
    margin-top: var(--sp-2);
  }

  .demo {
    font-size: var(--fs-meta);
  }

  /* --- experience / education --- */

  .history {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-5);
  }

  /* Period in a narrow column, the entry beside it, so the dates read as a
     timeline down the left and the titles line up. */
  .entry {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--sp-1) var(--sp-4);
    align-items: baseline;
  }

  /* Tracked a little tighter than other labels so the longest period,
     "2025年5月 - 2025年12月", stays on one line in its column. */
  .period {
    letter-spacing: 0.04em;
    line-height: 1.7;
  }

  .entry-body {
    min-width: 0;
  }

  .entry-title {
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .entry-detail {
    margin-top: var(--sp-1);
    color: var(--muted);
    font-size: var(--fs-lead);
  }

  .coursework {
    display: grid;
    gap: var(--sp-1);
    margin-top: var(--sp-3);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    padding-block: var(--sp-1);
  }

  @media screen and (max-width: 680px) {
    .spec-row,
    .entry {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .period {
      margin-bottom: 0.1rem;
    }
  }
</style>
