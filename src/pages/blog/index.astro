---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import Row from "../../components/Row.astro";
import PostList from "../../components/PostList.astro";
import { withBase } from "../../lib/url";
import { getPosts, getTags } from "../../lib/posts";

const posts = await getPosts();
const tags = await getTags();

const description =
  "nonica のブログ。OS、コンパイラ、コンピュータアーキテクチャなど低レイヤまわりの記録。";
---

<BaseLayout title="nonica | Blog" {description}>
  <PageHero title="Blog">
    <p class="label post-count">
      {posts.length}
      {posts.length === 1 ? "post" : "posts"}
    </p>
  </PageHero>

  {
    tags.length > 0 && (
      <Row label="Tags" delay={70}>
        <ul class="chips">
          {tags.map(({ tag, count }) => (
            <li>
              <a class="chip" href={withBase(`/blog/tags/${tag}`)}>
                {tag}
                <span class="count">{count}</span>
              </a>
            </li>
          ))}
        </ul>
      </Row>
    )
  }

  <Row wide delay={110}>
    <PostList {posts} showTags timeline />
  </Row>
</BaseLayout>

<style>
  .post-count {
    margin-top: var(--sp-3);
  }
</style>
