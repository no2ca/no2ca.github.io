---
import BaseLayout from "../layouts/BaseLayout.astro";
import Profile from "../components/Profile.astro";
import Row from "../components/Row.astro";
import TagList from "../components/TagList.astro";
import Links from "../components/Links.astro";
import Projects from "../components/Projects.astro";
import myIcon from "../assets/no2ca.svg";

const name = "nonica";
const update = "2026-03-30";
const description = "低レイヤ / OS開発を中心に学んでいる大学3年生です.";
const interests = ["OS", "Rust", "RISC-V", "x86", "Compiler"];

const links = [
  { name: "GitHub", url: "https://github.com/no2ca" },
  { name: "Cosense (Scrapbox)", url: "https://cosen.se/nonica" },
  { name: "Qiita", url: "https://qiita.com/nonica" },
  {
    name: "Bluesky",
    url: "https://bsky.app/profile/did:plc:wvwzypmkkewmn3yaedrpzncd",
  },
  { name: "X", url: "https://x.com/no2cax" },
];

const projects = [
  {
    name: "nex_os",
    description: "RISC-Vで動作するOS",
    url: "https://github.com/no2ca/nex_os",
  },
  {
    name: "lifegame",
    description: "ベアメタルのx86で動くライフゲーム",
    url: "https://github.com/no2ca/lifegame",
  },
  {
    name: "nonicc",
    description: "x86_64をターゲットにしたCコンパイラ",
    url: "https://github.com/no2ca/nonicc",
  },
];
---

<BaseLayout title="nonica | Home" description={description}>
  <Profile {myIcon} {name} {update} />

  <Row label="About" delay={70}>
    <p class="description">{description}</p>
  </Row>

  <Row label="Interests" delay={110}>
    <TagList items={interests} />
  </Row>

  <Row label="Links" delay={150}>
    <Links {links} />
  </Row>

  <Row label="Projects" delay={190}>
    <Projects {projects} />
  </Row>
</BaseLayout>

<style>
  .description {
    max-width: 56ch;
    font-weight: 300;
  }
</style>
