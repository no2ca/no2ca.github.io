---
import BaseLayout from "../layouts/BaseLayout.astro";
import Profile from "../components/Profile.astro";
import Row from "../components/Row.astro";
import Keywords from "../components/Keywords.astro";
import Links from "../components/Links.astro";
import PostList from "../components/PostList.astro";
import myIcon from "../assets/no2ca.svg";
import { withBase } from "../lib/url";
import { getPosts } from "../lib/posts";

const name = "nonica";
const update = "2026-09-08";

// The one place the site introduces itself; /portfolio no longer repeats it.
// The tagline sits under the name so the first glance answers who this is;
// About and Now each carry one thing, so they can be picked up at a scan.
const tagline = "低レイヤ / OS開発を中心に学んでいる大学3年生です.";
const about =
  "慶應義塾大学 環境情報学部に在籍し、OS・コンパイラ・コンピュータアーキテクチャを中心に、Rust と C で実装しながら内部構造を理解するスタイルで開発しています.";
const now = "現在は AArch64 向けハイパーバイザを継続開発中です.";

const interests = ["OS", "Rust", "RISC-V", "x86", "Compiler"];

const links = [
  { name: "GitHub", url: "https://github.com/no2ca" },
  { name: "Cosense (Scrapbox)", url: "https://cosen.se/nonica" },
  { name: "Qiita", url: "https://qiita.com/nonica" },
  {
    name: "Bluesky",
    url: "https://bsky.app/profile/did:plc:wvwzypmkkewmn3yaedrpzncd",
  },
  { name: "X", url: "https://x.com/no2cax" },
];

const latestPosts = (await getPosts()).slice(0, 3);
---

<BaseLayout title="nonica | Home" description={tagline}>
  <Profile {myIcon} {name} {tagline} {update} />

  <Row label="About" delay={70}>
    <p class="copy">{about}</p>
    <p class="more">
      <a class="more-link" href={withBase("/portfolio")}>
        View portfolio<span aria-hidden="true">→</span>
      </a>
    </p>
  </Row>

  <Row label="Now" delay={110}>
    <p class="copy">{now}</p>
  </Row>

  <Row label="Interests" delay={150}>
    <Keywords items={interests} />
  </Row>

  <Row label="Blog" delay={190}>
    <PostList posts={latestPosts} />
    <p class="more">
      <a class="more-link" href={withBase("/blog")}>
        View all posts<span aria-hidden="true">→</span>
      </a>
    </p>
  </Row>

  <Row label="Links" delay={230}>
    <Links {links} />
  </Row>
</BaseLayout>

<style>
  .copy {
    max-width: 60ch;
  }

  /* Whitespace, not a rule, separates the section's link from its content;
     the next rule down belongs to the next section. */
  .more {
    margin-top: var(--sp-4);
  }
</style>
