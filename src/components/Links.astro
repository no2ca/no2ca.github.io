---
export interface Props {
  links: { name: string; url: string }[];
}
const { links } = Astro.props;
---

<ul class="link-list">
  {
    links.map((link) => (
      <li>
        <a href={link.url} target="_blank" rel="noreferrer">
          {link.name}
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* One wrapping line of destinations. The arrow, not an underline, marks
     each as a link that leaves the site. */
  .link-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-6);
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    padding-block: var(--sp-1);
    font-size: var(--fs-lead);
    letter-spacing: 0.015em;
    color: var(--fg);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .arrow {
    color: var(--muted);
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  a:hover,
  a:hover .arrow {
    color: var(--accent);
  }

  a:hover .arrow {
    transform: translate(1px, -1px);
  }
</style>
