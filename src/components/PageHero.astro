---
export interface Props {
  /** Mono eyebrow shown in the label column, aligning with the Rows below.
      Leave it off when the title already says what the page is. */
  label?: string;
  title: string;
  /** Set for the page's own h1; off for pages where the title is a heading
      inside the content instead. */
  size?: "large" | "small";
}
const { label, title, size = "large" } = Astro.props;
---

<header class:list={["hero", "reveal", size]}>
  {label && <p class="label section-label">{label}</p>}
  <div class="hero-body">
    <h1>{title}</h1>
    <slot />
  </div>
</header>

<style>
  /* Mirrors the Row grid so the eyebrow lines up with the labels below it. */
  .hero {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    gap: 0 var(--sp-6);
    align-items: start;
    padding-block: var(--sp-10);
  }

  .hero-body {
    grid-column: 2;
    min-width: 0;
  }

  h1 {
    font-weight: 500;
  }

  .large h1 {
    font-size: clamp(1.9rem, 5.5vw, 2.5rem);
    line-height: 1.15;
  }

  .small h1 {
    font-size: clamp(1.4rem, 3.5vw, 1.8rem);
    line-height: 1.35;
  }

  @media screen and (max-width: 680px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: var(--sp-8);
    }

    .hero-body {
      grid-column: auto;
    }
  }
</style>
