---
import { withBase } from "../lib/url";

export interface Props {
  projects: {
    name: string;
    description: string;
    url: string;
  }[];
}
const { projects } = Astro.props;
---

<ul class="project-list">
  {
    projects.map((project) => (
      <li class="project">
        <a class="name" href={project.url} target="_blank" rel="noreferrer">
          {project.name}
          <span aria-hidden="true"> ↗</span>
        </a>
        <p>{project.description}</p>
      </li>
    ))
  }
</ul>

<p class="more">
  <a href={withBase("/portfolio")}>
    View full portfolio<span aria-hidden="true"> →</span>
  </a>
</p>

<style>
  .project-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-4);
  }

  .name {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.13rem;
    font-weight: 400;
    letter-spacing: 0.018em;
    line-height: 1.4;
    color: var(--fg);
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }

  .name:hover {
    color: var(--accent);
    transform: translateX(1px);
  }

  .project p {
    margin-top: 0.1rem;
    color: var(--muted);
    font-size: var(--fs-lead);
    font-weight: 300;
  }

  .more {
    margin-top: var(--sp-6);
    padding-top: var(--sp-3);
    border-top: var(--rule);
  }

  .more a {
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    color: var(--muted);
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
    display: inline-block;
  }

  .more a:hover {
    color: var(--accent);
    transform: translateX(1px);
  }
</style>
