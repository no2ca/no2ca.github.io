---
import type { ImageMetadata } from "astro";

export interface Props {
  myIcon: ImageMetadata;
  name: string;
  /** One sentence that answers "whose site is this?" before anything else. */
  tagline: string;
  update: string;
}
const { myIcon, name, tagline, update } = Astro.props;
---

<section class="profile reveal">
  <img class="avatar" src={myIcon.src} alt="" width="88" height="88" />

  <div class="content">
    <h1>{name}</h1>
    <p class="tagline">{tagline}</p>
    <p class="label updated">Updated {update}</p>
  </div>
</section>

<style>
  /* Shares the row grid so the avatar sits in the same column as the labels
     below it and the name starts on the content column's left edge. */
  .profile {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    gap: 0 var(--sp-6);
    align-items: center;
    padding-block: var(--hero-space-top) var(--hero-space-bottom);
  }

  .avatar {
    display: block;
    width: 88px;
    height: 88px;
    border: var(--rule);
    object-fit: cover;
  }

  h1 {
    font-size: clamp(1.6rem, 4.5vw, 2rem);
    font-weight: 400;
    line-height: 1.2;
  }

  .tagline {
    margin-top: var(--sp-3);
    text-wrap: pretty;
  }

  .updated {
    margin-top: var(--sp-4);
  }

  @media screen and (max-width: 680px) {
    /* Avatar and name side by side, the tagline running the full width
       beneath them: a profile card rather than a two-column sheet. */
    .profile {
      grid-template-columns: auto 1fr;
      gap: var(--sp-4);
    }

    .avatar {
      width: 56px;
      height: 56px;
    }

    .content {
      display: contents;
    }

    h1 {
      font-size: 1.5rem;
    }

    .tagline,
    .updated {
      grid-column: 1 / -1;
      margin-top: 0;
    }

    .tagline {
      margin-top: var(--sp-1);
    }

    .updated {
      margin-top: calc(var(--sp-2) * -1);
    }
  }
</style>
