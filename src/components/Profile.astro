---
import type { ImageMetadata } from "astro";

export interface Props {
  myIcon: ImageMetadata;
  name: string;
  update: string;
}
const { myIcon, name, update } = Astro.props;
---

<section class="profile">
  <div class="avatar">
    <img src={myIcon.src} alt="" width="100" height="100" />
  </div>

  <div class="content">
    <h1>{name}</h1>
    <p class="label">Last updated {update}</p>
  </div>
</section>

<style>
  /* Shares the row grid so the avatar sits in the same column as the labels
     below it. */
  .profile {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    gap: 0 var(--sp-6);
    align-items: center;
    padding-block: var(--sp-8);
    animation: rise 420ms ease both;
  }

  .avatar img {
    display: block;
    width: 100px;
    height: 100px;
    border: var(--rule);
    object-fit: cover;
  }

  .content {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 var(--sp-4);
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 2.2rem);
    font-weight: 400;
    line-height: 1.18;
    letter-spacing: 0.015em;
  }

  .content .label {
    line-height: 1.6;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 680px) {
    .profile {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
      padding-block: var(--sp-6);
    }

    .avatar img {
      width: 88px;
      height: 88px;
    }

    .content {
      flex-direction: column;
      gap: var(--sp-1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile {
      animation: none;
    }
  }
</style>
