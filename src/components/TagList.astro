---
export interface Props {
  items: string[];
}
const { items } = Astro.props;
---

<ul class="tags">
  {items.map((item) => <li class="tag">{item}</li>)}
</ul>

<style>
  .tags {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .tag {
    border: var(--rule);
    padding: 0.15rem 0.55rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--fs-meta);
    font-weight: 300;
    line-height: 1.6;
  }
</style>
