---
export interface Props {
  label?: string;
  /** Anchor target, for in-page navigation. */
  id?: string;
  /** Entrance animation offset, in ms. */
  delay?: number;
  /** Drops the label column so the body spans the full measure — for long
      running content such as an article body. */
  wide?: boolean;
}
const { label, id, delay = 0, wide = false } = Astro.props;
---

<section
  class:list={["row", "reveal", { wide }]}
  {id}
  style={`--reveal-delay: ${delay}ms;`}
>
  {label && <h2 class="section-label">{label}</h2>}
  <div class="row-body"><slot /></div>
</section>

<style>
  /* A section is a rule, then a label column beside a content column. The
     rule is the only horizontal line on the page that means "new section",
     so nothing inside a row draws another one. */
  .row {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    gap: 0 var(--sp-6);
    padding-block: var(--sp-8);
    border-top: var(--rule);
    scroll-margin-top: var(--sp-4);
  }

  /* Pinned to the content column so a label-less Row does not fall back into
     the narrow label column. */
  .row-body {
    grid-column: 2;
    min-width: 0;
  }

  .row.wide {
    grid-template-columns: 1fr;
  }

  .row.wide .row-body {
    grid-column: auto;
  }

  @media screen and (max-width: 680px) {
    .row {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: var(--sp-6);
    }

    .row-body {
      grid-column: auto;
    }
  }
</style>
