---
export interface Props {
  label?: string;
  /** Entrance animation offset, in ms. */
  delay?: number;
  /** Drops the label column so the body spans the full measure — for long
      running content such as an article body. */
  wide?: boolean;
}
const { label, delay = 0, wide = false } = Astro.props;
---

<section class:list={["row", { wide }]} style={`--reveal-delay: ${delay}ms;`}>
  {label && <p class="label section-label">{label}</p>}
  <div class="row-body"><slot /></div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    gap: 0 var(--sp-6);
    padding-block: var(--sp-6);
    border-top: var(--rule);
    animation: rise 420ms ease both;
    animation-delay: var(--reveal-delay, 0ms);
  }

  /* Pinned to the content column so a label-less Row does not fall back into
     the narrow label column. */
  .row-body {
    grid-column: 2;
    min-width: 0;
  }

  .row.wide {
    grid-template-columns: 1fr;
  }

  .row.wide .row-body {
    grid-column: auto;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media screen and (max-width: 680px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--sp-2);
      padding-block: var(--sp-4);
    }

    .row-body {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row {
      animation: none;
    }
  }
</style>
