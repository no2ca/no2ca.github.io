---
import { withBase } from "../lib/url";

const nav = [
  { name: "Blog", href: withBase("/blog") },
  { name: "Portfolio", href: withBase("/portfolio") },
];

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const current = normalize(Astro.url.pathname);

// Section pages keep their nav item marked while you are anywhere beneath
// them (/blog/<slug>, /blog/tags/<tag>).
const isCurrent = (href: string) => {
  const path = normalize(href);
  return current === path || current.startsWith(`${path}/`);
};
---

<header class="site-header">
  <a class="home" href={withBase("/")}>no2ca.github.io</a>

  <nav class="nav" aria-label="サイト内ナビゲーション">
    {
      nav.map((item) => (
        <a
          class="nav-link label"
          href={item.href}
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          {item.name}
        </a>
      ))
    }
    <button
      type="button"
      class="theme-toggle label"
      data-theme-toggle
      aria-live="polite"
    >
      <span data-theme-toggle-label>Dark mode</span>
    </button>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
    padding-bottom: var(--sp-3);
    border-bottom: var(--rule);
  }

  /* The site mark: the domain rather than a personal name. Mono keeps it
     reading as an address and sets it apart from the nav labels. */
  .home {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    color: var(--fg);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .home:hover {
    color: var(--accent);
  }

  .nav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .nav-link {
    padding-bottom: 0.1rem;
    border-bottom: 1px solid transparent;
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .nav-link[aria-current="page"] {
    color: var(--fg);
    border-bottom-color: var(--line);
  }

  .nav-link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .theme-toggle {
    border: var(--rule);
    background: transparent;
    padding: 0.18rem 0.5rem;
    line-height: 1.5;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media screen and (max-width: 520px) {
    .site-header {
      flex-direction: column;
      align-items: stretch;
    }

    /* Without this the header's `align-items: stretch` widens the link to
       the full row, making the whole line clickable. */
    .home {
      align-self: flex-start;
    }

    .nav {
      width: 100%;
    }

    /* Keeps the two nav links grouped on the left with the toggle pinned
       right, rather than scattering all three across the row. */
    .theme-toggle {
      margin-left: auto;
    }
  }
</style>
